  "runtimes": [],
  "profiles": {
    "static": {
      "description": "Analyze source, secrets, dependencies, filesystems, images, and supply-chain metadata.",
      "skills": ["security-testing"],
      "runtimes": []
    },
    "dynamic": {
      "description": "Assess authorized web, API, network, protocol, and load behavior.",
      "skills": ["security-testing"],
      "runtimes": []
    }
  },
  "dependencies": [
    { "id": "semgrep", "check": ["semgrep", "--version"], "optional": true, "profiles": ["static"] },
